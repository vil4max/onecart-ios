    "settings.apple_name_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One name for Apple Account and how you appear in the cart. Sign out clears the local Apple session and returns to Welcome; it does not sign out of iCloud on the device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно имя для аккаунта Apple и того, как вас видят в корзине. Выход очищает локальную сессию Apple и возвращает на Welcome; из iCloud на устройстве вы не выходите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне ім’я для акаунта Apple і того, як вас бачать у кошику. Вихід очищає локальну сесію Apple і повертає на Welcome; з iCloud на пристрої ви не виходите."
          }
