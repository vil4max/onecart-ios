    },
    "account.display_name_prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when Sign in with Apple did not provide a name. The same name appears in the cart member list and on items you add."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, если Sign in with Apple не отдал имя. То же имя видно в списке участников корзины и на товарах, которые вы добавляете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно, якщо Sign in with Apple не віддав ім’я. Те саме ім’я видно в списку учасників кошика і на товарах, які ви додаєте."
          }
        }
      }
    },
