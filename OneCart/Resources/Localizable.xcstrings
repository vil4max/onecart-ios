    "account.delete_cart_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Members lose access and the old invite link stops working. You get a new empty cart you can share again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Участники потеряют доступ, старая ссылка перестанет работать. У вас появится новая пустая корзина — её можно снова поделиться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Учасники втратять доступ, старе посилання перестане працювати. У вас з’явиться новий порожній кошик — ним можна знову поділитися."
          }
        }
      }
    },
    "account.delete_cart_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recreate this cart?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
