    "%@" : {
      "comment" : "A count of the number of family members in the cart.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "comment" : "A label displaying the quantity and unit of a product. The first argument is the quantity. The second argument is the unit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ из %@" : {
      "comment" : "A label showing the number of products in the shopping list that have been purchased. The first argument is the number of purchased products. The second argument is the total number of products in the list.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ из %2$@"
          }
        }
      }
    },
    "%@ потеряет доступ к этой корзине." : {
      "comment" : "A confirmation alert that lets the user delete a family member. The argument is the name of the family member to be deleted.",
      "isCommentAutoGenerated" : true
    },
    "%@ товаров · %@" : {
