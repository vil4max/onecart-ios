        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У кого есть ссылка, может присоединиться и править корзину. Удалите корзину, чтобы отозвать ссылку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хто має посилання, може приєднатися й редагувати кошик. Видаліть кошик, щоб відкликати посилання."
          }
        }
