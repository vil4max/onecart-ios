{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "A count of the number of family members in the cart.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "comment" : "A label displaying the quantity and unit of a product. The first argument is the quantity. The second argument is the unit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ из %@ куплено" : {
      "comment" : "A description of the number of items in the user's shopping list and the number of items they've purchased.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ из %2$@ куплено"
          }
        }
      }
    },
    "%@ потеряет доступ к этой группе." : {
      "comment" : "A confirmation alert that lets the user delete a family member. The argument is the name of the family member to be deleted.",
      "isCommentAutoGenerated" : true
    },
    "%@ с картой ATB" : {
      "comment" : "A price for a product with a loyalty card.",
      "isCommentAutoGenerated" : true
    },
    "%@ товаров · %@" : {
      "comment" : "A line of text that shows the number of items in a purchase and the number of people who purchased it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ товаров · %2$@"
          }
        }
      }
    },
    "+%@" : {
      "comment" : "A button that shows the number of additional family members beyond the first 4.",
      "isCommentAutoGenerated" : true
    },
    "−%@%%" : {
      "comment" : "A discount badge. The discount is shown as a negative percentage.",
      "isCommentAutoGenerated" : true
    },
