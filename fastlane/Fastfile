default_platform(:ios)

def project_path
  "ios/App/App.xcodeproj"
end

def api_key
  key_id = ENV["ASC_KEY_ID"]
  issuer_id = ENV["ASC_ISSUER_ID"]
  key_content = ENV["ASC_KEY_CONTENT"]

  UI.user_error!("Missing ASC_KEY_ID secret") if key_id.to_s.empty?
  UI.user_error!("Missing ASC_ISSUER_ID secret") if issuer_id.to_s.empty?
  UI.user_error!("Missing ASC_KEY_CONTENT secret") if key_content.to_s.empty?

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: ENV.fetch("ASC_KEY_BASE64", "true") == "true"
  )
end

def export_options
  profile_name = ENV["IOS_APPSTORE_PROFILE_NAME"]
  options = {
    method: "app-store",
    teamID: "BTHRDS7254",
    uploadSymbols: true,
    signingStyle: profile_name.to_s.empty? ? "automatic" : "manual"
  }
  unless profile_name.to_s.empty?
    options[:provisioningProfiles] = {
      "com.vil555tim.onecart" => profile_name
    }
  end
  options
end

platform :ios do
  desc "Create a signed App Store IPA without uploading"
  lane :build do
    setup_ci if ENV["CI"]

    if ENV["GITHUB_RUN_NUMBER"]
      increment_build_number(
        xcodeproj: project_path,
        build_number: ENV["GITHUB_RUN_NUMBER"]
      )
    end

    build_app(
      project: project_path,
      scheme: "App",
      configuration: "Release",
      clean: true,
      output_directory: "build",
      output_name: "OneCart.ipa",
      export_method: "app-store",
      export_options: export_options,
      xcargs: "DEVELOPMENT_TEAM=BTHRDS7254 -allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Archive and upload a Release build to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    if ENV["GITHUB_RUN_NUMBER"]
      increment_build_number(
        xcodeproj: project_path,
        build_number: ENV["GITHUB_RUN_NUMBER"]
      )
    end

    connect_key = api_key

    build_app(
      project: project_path,
      scheme: "App",
      configuration: "Release",
      clean: true,
      output_directory: "build",
      output_name: "OneCart.ipa",
      export_method: "app-store",
      export_options: export_options,
      xcargs: "DEVELOPMENT_TEAM=BTHRDS7254 -allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: connect_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Upload the latest build/OneCart.ipa to TestFlight"
  lane :upload do
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/OneCart.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
